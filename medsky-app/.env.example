# Copy this file to .env and fill in values from medsky_homepage's Supabase project
# (same values as its NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY).
# Expo only exposes vars prefixed with EXPO_PUBLIC_ to the client bundle.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# medsky_homepage 배포 주소. 생기부/수시/정시 화면이 쓰는 /api/mobile/** 가 여기 있다.
# 비워 두면 https://medsky.co.kr 을 쓴다. 로컬 개발 중이라면 실제 기기에서 열리는
# 주소여야 한다 (localhost 는 시뮬레이터 밖에서 동작하지 않는다).
EXPO_PUBLIC_API_BASE_URL=
